{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": "{public/**,data/product-images.csv,data/products-v2.json,data/store.db}" }
    }
  ],
  "routes": [
    { "src": "/favicon.ico", "status": 302, "headers": { "Location": "/public/favicon.svg" } },
    { "src": "/public/(.*)", "dest": "/api/index.js?__public=$1" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
